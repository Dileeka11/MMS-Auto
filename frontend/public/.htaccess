# --- Frontend SPA (Vite build) served by Apache ---

# Gzip text assets over the wire (JS/CSS/HTML/SVG). Big transport win.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript text/javascript \
        text/html text/plain text/css application/json image/svg+xml \
        application/vnd.ms-fontobject application/x-font-ttf font/opentype
</IfModule>

# Content-hashed assets (Vite emits e.g. Procurement-BK5NWVlY.js) never change
# for a given hash, so cache them for a year and mark immutable.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html must always revalidate so new builds are picked up immediately.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Browser hardening for the SPA. Scripts only from this origin (no inline
    # JS); inline styles are needed because React components use style={...}.
    Header always set X-Content-Type-Options "nosniff"
    # SAMEORIGIN (not DENY): the admin panel iframes /rep-app/ for the mobile preview.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Rep mobile app download (public/downloads/nms-sales-rep.apk): correct MIME so
# Android offers to install it, always downloaded, and revalidated on each build.
AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
    <FilesMatch "\.apk$">
        Header set Content-Disposition "attachment"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Never serve dotfiles or source maps.
<FilesMatch "(^\.|\.map$)">
    Require all denied
</FilesMatch>

# SPA routing: serve index.html for any path that isn't a real file/dir.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
